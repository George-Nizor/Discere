      {
        "id": "strain-and-stiffness",
        "kind": "explain",
        "blocks": [],
        "headline": "Strain is the stretch as a fraction of the length, and stress is E times strain.",
        "lead": [
          {
            "kind": "paragraph",
            "text": "Strain is extension divided by original length, ε = δ/L. It has no unit. In the elastic range, stress and strain are proportional: σ = E × ε. E, Young's modulus, measures stiffness: steel is about 200 GPa, which is 200,000 MPa."
          }
        ],
        "reveal": [],
        "introducesTerms": [
          "strain",
          "Young's modulus"
        ],
        "visualStateId": "",
        "checkQuestionId": "engr-stress-and-strain-11",
        "activityId": ""
      },
      {
        "id": "stretch-of-a-bar",
        "kind": "worked_example",
        "blocks": [],
        "headline": "A 3,000 mm steel bar (E = 200 GPa) carries a stress of 60 MPa. How far does it stretch?",
        "lead": [],
        "reveal": [],
        "visualStateId": "",
        "workedSteps": [
          {
            "text": "Write E in MPa so that it matches the unit of stress.",
            "math": "E = 200,000 MPa",
            "selfExplain": {
              "questionId": "engr-stress-and-strain-9"
            }
          },
          {
            "text": "Strain is stress divided by E.",
            "math": "ε = 60 ÷ 200,000 = 0.0003"
          },
          {
            "text": "Stretch is strain times the original length.",
            "math": "δ = 0.0003 × 3,000 = 0.9 mm"
          }
        ],
        "checkQuestionId": "",
        "activityId": ""
      },
      {
