    "title": "Stress, strain and stiffness",
    "steps": [
      {
        "id": "force-on-each-square-millimetre",
        "kind": "explain",
        "blocks": [],
        "headline": "Stress is the force carried by each square millimetre of the cross-section.",
        "lead": [
          {
            "kind": "paragraph",
            "text": "Stress is internal force per unit area, σ = F/A. Use newtons and square millimetres: 1 N/mm² is 1 MPa. Stress, not force, decides whether a material yields, so a thicker bar carries the same force at lower stress."
          }
        ],
        "reveal": [],
        "introducesTerms": [
          "stress"
        ],
        "visualStateId": "",
        "checkQuestionId": "engr-stress-and-strain-8",
        "activityId": ""
      },
      {
        "id": "stress-in-a-bar",
        "kind": "predict",
        "blocks": [],
        "lead": [
          {
            "kind": "paragraph",
            "text": "Convert the load to newtons first, then divide by the area."
          }
        ],
        "reveal": [
          {
            "kind": "paragraph",
            "text": "You divided 20,000 N by 400 mm² to get 50 N/mm², which is 50 MPa. A bar of half the area would carry twice that stress."
          }
        ],
        "diagram": {
          "type": "engineering_explorer",
          "cases": [
            {
