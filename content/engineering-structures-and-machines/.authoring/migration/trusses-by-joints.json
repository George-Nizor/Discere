    "steps": [
      {
        "id": "push-or-pull",
        "kind": "explain",
        "blocks": [],
        "headline": "Each truss member carries a pure push or pull, and you find it one joint at a time.",
        "lead": [
          {
            "kind": "paragraph",
            "text": "A truss is a frame of straight members pinned at joints and loaded only at joints. So each member is pulled (tension) or pushed (compression) along its length. The method of joints isolates one joint and balances the forces on it."
          }
        ],
        "reveal": [],
        "introducesTerms": [
          "truss",
          "tension",
          "compression"
        ],
        "visualStateId": "",
        "checkQuestionId": "engr-trusses-by-joints-8",
        "activityId": ""
      },
      {
        "id": "the-apex-joint",
        "kind": "predict",
        "blocks": [],
        "lead": [
          {
            "kind": "paragraph",
            "text": "Isolate the apex joint, C. The two sloping members push on it equally, and their vertical parts together must hold up the load."
          }
        ],
        "reveal": [
          {
            "kind": "paragraph",
            "text": "Each member's vertical part is its force times rise over length, 1.5/2.5. Two of them hold up 12 kN, so 2F × 1.5/2.5 = 12 and F = 10 kN."
          }
        ],
