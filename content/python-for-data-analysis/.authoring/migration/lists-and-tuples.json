      {
        "id": "copy-one-level",
        "kind": "explain",
        "blocks": [],
        "headline": "list.copy is shallow: the outer list is new, but any lists inside it are still shared.",
        "lead": [
          {
            "kind": "paragraph",
            "text": "A copy has its own list of items. If an item is itself a list, the copy holds the same inner list as the original. A tuple works this way too: it stops you replacing an item, but it cannot freeze a list inside it."
          }
        ],
        "reveal": [],
        "introducesTerms": [
          "shallow copy"
        ],
        "visualStateId": "",
        "checkQuestionId": "python-lists-and-tuples-shallow-check",
        "activityId": "",
        "diagram": {
