        "blocks": [],
        "lead": [
          {
            "kind": "paragraph",
            "text": "Both values start as text. int() converts numeric text into a whole number before the + sees it."
          }
        ],
        "reveal": [
          {
            "kind": "paragraph",
            "text": "You added numbers, not characters. Once int() has converted the text, + adds as it does anywhere else."
          }
        ],
        "visualStateId": "",
        "checkQuestionId": "python-numbers-and-types-1",
