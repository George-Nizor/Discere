        "kind": "explain",
        "blocks": [],
        "headline": "Every value has a type, and the type decides what + does.",
        "lead": [
          {
            "kind": "paragraph",
            "text": "'12' in quotation marks is text, called a str. 12 on its own is a whole number, called an int. Adding numbers adds them. Adding strings joins them end to end. int('12') turns numeric text into a number."
          },
          {
            "kind": "callout",
            "tone": "key",
            "text": "Quotation marks make text, even when the characters are digits."
          }
        ],
        "reveal": [],
        "introducesTerms": [
          "type"
        ],
        "visualStateId": "",
        "checkQuestionId": "python-numbers-and-types-type-check",
        "activityId": ""
      },
