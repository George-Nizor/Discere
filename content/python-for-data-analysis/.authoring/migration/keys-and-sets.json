      {
        "id": "in-both-or-either",
        "kind": "transfer",
        "blocks": [],
        "lead": [
          {
            "kind": "paragraph",
            "text": "Set operators combine two sets. & keeps members in both. | keeps members in either. - keeps members of the left set that are not in the right."
          }
        ],
        "reveal": [
          {
            "kind": "paragraph",
            "text": "Only members present in both sets survive an intersection. The same idea answers any question of the form: which are in both lists?"
          }
        ],
