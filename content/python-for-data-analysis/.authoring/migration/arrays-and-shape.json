      {
        "id": "bytes-per-value",
        "kind": "transfer",
        "blocks": [],
        "lead": [
          {
            "kind": "paragraph",
            "text": "NumPy integer dtypes have fixed widths. int16 uses 16 bits, which is 2 bytes, for every value. Python's own int can grow; an array dtype cannot."
          }
        ],
        "reveal": [
          {
            "kind": "paragraph",
            "text": "Every item takes the same fixed number of bytes, so storage grows with the count. A Python int has no such fixed width."
          }
        ],
        "visualStateId": "",
        "checkQuestionId": "python-arrays-and-shape-4",
        "activityId": "",
