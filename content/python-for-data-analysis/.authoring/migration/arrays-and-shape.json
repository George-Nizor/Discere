        "id": "a-grid-of-one-type",
        "kind": "explain",
        "blocks": [],
        "headline": "An array is a grid of values of one type, and its shape gives rows first, then columns.",
        "lead": [
          {
            "kind": "paragraph",
            "text": "np.array([[1, 2, 3], [4, 5, 6]]) has 2 rows and 3 columns, so its shape is (2, 3). size counts every element. ndim counts the axes. Arithmetic on an array acts on every element at once."
          },
          {
            "kind": "callout",
            "tone": "key",
            "text": "A list holds anything. An array holds one dtype and calculates on all of it."
          }
        ],
        "reveal": [],
        "introducesTerms": [
          "array",
          "shape"
        ],
        "visualStateId": "",
        "checkQuestionId": "python-arrays-and-shape-shape-check",
