      {
        "id": "twice-over",
        "kind": "explain",
        "blocks": [],
        "lead": [
          {
            "kind": "paragraph",
            "text": "Area is made from two lengths, a length and a width. A scale factor works on both of them."
          },
          {
            "kind": "paragraph",
            "text": "So the factor acts twice on the area. We call the result the area factor."
          },
          {
            "kind": "callout",
            "tone": "key",
            "text": "Length factor k gives area factor k × k."
          }
        ],
        "reveal": [],
        "visualStateId": "",
