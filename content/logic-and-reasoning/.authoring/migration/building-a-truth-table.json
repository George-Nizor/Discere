    "title": "Building a truth table",
    "steps": [
      {
        "id": "every-setting",
        "kind": "explain",
        "eyebrow": "New idea",
        "headline": "A truth table lists every setting once, with the result of a formula beside each.",
        "lead": [
          {
            "kind": "paragraph",
            "text": "Treat the lamps as two claims. p is “Lamp 1 is on” and q is “Lamp 2 is on”. Each row is one setting, written TT, TF, FT or FF. A table that skips a row, or repeats one, is wrong."
          }
        ],
        "introducesTerms": [
          "truth table"
        ],
        "checkQuestionId": "logic-and-reasoning-building-a-truth-table-rows-check",
        "blocks": [],
        "reveal": [],
        "visualStateId": "",
        "activityId": ""
      },
      {
        "id": "both-needed",
        "kind": "predict",
        "eyebrow": "Predict",
        "lead": [
          {
            "kind": "paragraph",
            "text": "The symbol ∧ reads “and”: p ∧ q says that p holds and q holds. Go through the four rows and test it in each."
          }
        ],
        "diagram": {
          "type": "truth_table",
          "formula": "p_and_q",
          "p": false,
          "q": false
        },
        "answerVisibility": "hidden-until-response",
        "reveal": [
          {
            "kind": "paragraph",
            "text": "Compare your count with the table. Only TT survives: each other row leaves one claim false."
          }
        ],
        "checkQuestionId": "logic-and-reasoning-building-a-truth-table-2",
        "blocks": [],
        "visualStateId": "",
        "activityId": ""
      },
      {
        "id": "inclusive-or",
        "kind": "explain",
        "eyebrow": "New idea",
        "headline": "In logic, p ∨ q reads “p or q” and includes the case where both are true.",
        "lead": [
          {
            "kind": "paragraph",
            "text": "Everyday “or” sometimes means one or the other but not both. The symbol ∨ doesn't. We settle the question now, so that every table in this course reads the same way."
          }
        ],
        "introducesTerms": [
          "inclusive or"
        ],
        "checkQuestionId": "logic-and-reasoning-building-a-truth-table-inclusive-check",
        "blocks": [],
        "reveal": [],
        "visualStateId": "",
        "activityId": ""
      },
      {
        "id": "count-the-ors",
        "kind": "try",
        "eyebrow": "Try it",
        "lead": [
          {
            "kind": "paragraph",
            "text": "Use the four rows again, this time for p ∨ q."
          }
        ],
        "diagram": {
          "type": "truth_table",
          "formula": "p_or_q",
          "p": false,
          "q": false
        },
        "answerVisibility": "hidden-until-response",
        "checkQuestionId": "logic-and-reasoning-building-a-truth-table-3",
        "blocks": [],
        "reveal": [],
        "visualStateId": "",
        "activityId": ""
      },
      {
        "id": "must-q-be-true",
        "kind": "worked_example",
        "eyebrow": "Worked example",
        "headline": "“p or q” is true and p is not. Must q be true?",
        "workedSteps": [
          {
            "text": "List all four rows.",
            "math": "TT, TF, FT, FF"
          },
          {
            "text": "Keep the rows where p ∨ q is true.",
            "math": "TT, TF, FT"
          },
          {
            "text": "Keep the rows where p is not true.",
            "math": "FT",
            "selfExplain": {
              "questionId": "logic-and-reasoning-building-a-truth-table-why-discard"
            }
          },
          {
            "text": "q is true in the one row left. In every row that matches what we know, q is true.",
            "math": "q is true"
          }
        ],
        "blocks": [],
        "reveal": [],
        "visualStateId": "",
        "activityId": "",
        "checkQuestionId": ""
      },
