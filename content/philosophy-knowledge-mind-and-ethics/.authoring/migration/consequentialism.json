      {
        "id": "when-harm-counts",
        "kind": "worked_example",
        "blocks": [],
        "headline": "A treatment gives 10 units of benefit with probability 0.7 and causes 20 units of harm with probability 0.3. Is it worth giving?",
        "lead": [],
        "reveal": [],
        "workedSteps": [
          {
            "text": "Give the harm a negative value.",
            "math": "−20",
            "selfExplain": {
              "questionId": "phil-consequentialism-9"
            }
          },
          {
            "text": "Weight each outcome by its probability.",
            "math": "0.7 × 10 = 7 and 0.3 × (−20) = −6"
          },
          {
            "text": "Add them. The total is positive, so the treatment beats doing nothing, which scores 0.",
            "math": "7 − 6 = 1"
          }
        ],
        "visualStateId": "",
        "checkQuestionId": "",
        "activityId": ""
