      {
        "id": "the-transmitter-room",
        "kind": "transfer",
        "blocks": [],
        "lead": [
          {
            "kind": "paragraph",
            "text": "T. M. Scanlon imagined Jones, trapped and receiving painful shocks. Freeing him means cutting a broadcast that millions are watching, for an hour."
          },
          {
            "kind": "paragraph",
            "text": "Summed, the viewers' small losses can outweigh Jones's suffering. Ask which feature of utilitarianism produces that verdict."
          }
        ],
        "reveal": [
          {
            "kind": "paragraph",
            "text": "That feature is aggregation: summing welfare across people. Critics say it ignores the separateness of persons."
          }
        ],
        "answerVisibility": "hidden-until-response",
