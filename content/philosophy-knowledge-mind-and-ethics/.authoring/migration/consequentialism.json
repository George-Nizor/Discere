    "title": "Counting consequences",
    "steps": [
      {
        "id": "weighing-outcomes",
        "kind": "explain",
        "blocks": [],
        "headline": "Expected utility weights each outcome's value by its probability.",
        "lead": [
          {
            "kind": "paragraph",
            "text": "Consequentialism judges an act by its outcomes. When the outcomes are uncertain, multiply each outcome's value by its probability and add."
          },
          {
            "kind": "paragraph",
            "text": "The total is the act's expected utility."
          }
        ],
        "reveal": [],
        "introducesTerms": [
          "expected utility"
        ],
        "visualStateId": "",
        "checkQuestionId": "phil-consequentialism-8",
        "activityId": ""
      },
      {
        "id": "sure-or-gamble",
        "kind": "predict",
        "blocks": [],
        "lead": [
          {
            "kind": "paragraph",
            "text": "Option B has two outcomes. Weight each value by its probability and add, then compare the total with the sure 50."
          }
        ],
        "reveal": [
          {
            "kind": "paragraph",
            "text": "You weighed the gamble: 0.6 × 100 + 0.4 × 0 comes to more than the sure 50. An expected-utility maximiser takes the gamble; a cautious agent might not."
          }
        ],
        "answerVisibility": "hidden-until-response",
        "visualStateId": "",
