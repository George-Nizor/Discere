    "steps": [
      {
        "id": "defined-by-what-it-does",
        "kind": "explain",
        "blocks": [],
        "headline": "A functional state is defined by what it does, not what it is made of.",
        "lead": [
          {
            "kind": "paragraph",
            "text": "A machine table gives, for each state and input, the next state and the output. In Ned Block's drinks machine, “10p credited” is whatever state turns a further 10p into a can."
          },
          {
            "kind": "paragraph",
            "text": "Nothing in the table mentions gears or chips."
          }
        ],
        "reveal": [],
        "introducesTerms": [
          "machine table",
          "functional state"
        ],
        "visualStateId": "",
        "checkQuestionId": "phil-functionalism-and-the-chinese-room-8",
        "activityId": ""
      },
      {
        "id": "three-coins",
        "kind": "predict",
        "blocks": [],
        "lead": [
          {
            "kind": "paragraph",
            "text": "Block's machine sells a can for 20p and starts with nothing owed. From nothing owed, a 10p moves it to 10p credited with no output. From 10p credited, a 10p buys a can and returns it to nothing owed."
          }
        ],
        "reveal": [
          {
            "kind": "paragraph",
            "text": "You ran the table: credit, can, credit again. The state “10p credited” is just whatever role it plays in the next move."
          }
        ],
        "answerVisibility": "hidden-until-response",
