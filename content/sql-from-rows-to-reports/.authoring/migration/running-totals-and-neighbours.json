      {
        "id": "a-frame-of-rows",
        "kind": "explain",
        "blocks": [],
        "lead": [
          {
            "kind": "paragraph",
            "text": "A window can sum the rows from the first one up to the current one. That is a running total, and the frame is the range of rows it adds."
          },
          {
            "kind": "callout",
            "tone": "key",
            "text": "The order inside OVER decides which row is first, and so which rows come before."
          }
        ],
        "reveal": [],
        "visualStateId": "",
        "checkQuestionId": "sql-running-totals-and-neighbours-8",
        "activityId": "",
        "headline": "A frame says which rows count toward each row's value.",
        "introducesTerms": [
          "frame",
          "running total"
        ]
      },
      {
        "id": "total-so-far",
        "kind": "predict",
        "blocks": [],
        "lead": [
          {
            "kind": "paragraph",
            "text": "The frame here runs from the first ordered row to the current row. The last amount is unknown, so it adds no known value."
          }
        ],
        "reveal": [
          {
            "kind": "paragraph",
            "text": "You added the rows up to and including the current one. The grand total would use every row at once."
          }
        ],
