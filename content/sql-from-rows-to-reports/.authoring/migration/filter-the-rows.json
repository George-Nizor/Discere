    "title": "Write the condition you mean",
    "steps": [
      {
        "id": "keep-what-is-true",
        "kind": "explain",
        "blocks": [],
        "lead": [
          {
            "kind": "paragraph",
            "text": "A condition is a test on each row, such as amount > 50. WHERE keeps the rows that pass and drops the rest."
          },
          {
            "kind": "paragraph",
            "text": "A comparison with an unknown amount is never true, so those rows are dropped too. To find unknown amounts, write IS NULL."
          }
        ],
        "reveal": [],
        "visualStateId": "",
        "checkQuestionId": "sql-filter-the-rows-8",
        "activityId": "",
        "headline": "WHERE keeps only the rows whose condition is true.",
        "introducesTerms": [
          "WHERE",
          "condition",
          "IS NULL"
        ]
      },
