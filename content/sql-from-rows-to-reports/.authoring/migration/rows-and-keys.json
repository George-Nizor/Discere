    "title": "Know what a row represents",
    "steps": [
      {
        "id": "what-a-row-is",
        "kind": "explain",
        "blocks": [],
        "lead": [
          {
            "kind": "paragraph",
            "text": "A table is a grid. Each row is one thing, such as one order. Each column is one fact about it."
          },
          {
            "kind": "paragraph",
            "text": "A primary key is a column that differs in every row, so it names the row. In these tables it is id."
          },
          {
            "kind": "callout",
            "tone": "key",
            "text": "A column that holds another table's key, like customer_id, can repeat."
          }
        ],
        "reveal": [],
        "visualStateId": "",
        "checkQuestionId": "sql-rows-and-keys-8",
        "activityId": "",
        "headline": "A row is one thing, and its primary key is its name.",
        "introducesTerms": [
          "row",
          "primary key"
        ]
      },
