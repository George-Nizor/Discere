{
  "name": "@discere/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@discere/assessment-engine": "workspace:*",
    "@discere/contracts": "workspace:*",
    "@discere/curriculum": "workspace:*",
    "@discere/paths": "workspace:*",
    "@discere/progression-engine": "workspace:*",
    "@discere/prompts": "workspace:*",
    "@discere/tutor-providers": "workspace:*",
    "@discere/visual-engine": "workspace:*",
    "@discere/writing-engine": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "better-sqlite3": "^13.0.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "drizzle-kit": "0.31.10",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
