# Copied to ~/discere/discere.env on the first deploy; edit it there, not here.
# Loopback only: the Cloudflare tunnel on the same machine forwards to it.
HOST=127.0.0.1
PORT=8790
DISCERE_DATA_DIR=/home/gnizorid/discere/data
DISCERE_WEB_ROOT=apps/web/dist
DISCERE_AUTO_MIGRATE=1
# The tunnel's address. Requests addressed to any other name are refused.
DISCERE_ALLOWED_HOSTS=discere.georgenizoridis.com

# The tutor runs on the homelab's Ollama (the RTX 2070). Gemma 3 4B read the full tutor prompt
# in about 5 seconds and answered correctly; Gemma 4 E2B took four minutes to read it.
DISCERE_TUTOR_PROVIDER=openai-compatible
DISCERE_AI_BASE_URL=http://127.0.0.1:11434/v1
DISCERE_AI_FAST_MODEL=gemma3:4b-it-qat
DISCERE_AI_SMART_MODEL=gemma3:4b-it-qat
DISCERE_AI_OUTPUT=json
DISCERE_AI_REASONING_EFFORT=none
# The lesson as a short outline: Ollama on the 2070 stalls on the full 40,000-character lesson.
DISCERE_TUTOR_CONTEXT=compact
# Loads the model as a lesson opens: from the homelab's disk it takes minutes.
DISCERE_AI_WARM=1
# A cold model can still be loading when the first question arrives.
DISCERE_TUTOR_ASK_TIMEOUT_MS=180000

# Drawn illustrations need the Codex CLI, which the homelab does not have.
DISCERE_IMAGE_GENERATION=off
