# Discere is intentionally local-only during the prototype phase.
DISCERE_HOST=127.0.0.1
DISCERE_PORT=4317
DISCERE_WEB_HOST=127.0.0.1
DISCERE_WEB_PORT=4318

# Durable local state. This file is ignored by Git.
# A relative path resolves from the repository root, not the working directory.
DISCERE_DATABASE_PATH=./data/discere.sqlite
DISCERE_LEARNER_NAME=Learner
