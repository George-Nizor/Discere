# Discere is intentionally local-only during the prototype phase.
DISCERE_HOST=127.0.0.1
DISCERE_PORT=4317
DISCERE_WEB_HOST=127.0.0.1
DISCERE_WEB_PORT=4318

# Durable local state. This file is ignored by Git.
# A relative path resolves from the repository root, not the working directory.
DISCERE_DATABASE_PATH=./data/discere.sqlite
DISCERE_LEARNER_NAME=Learner

# Which AI drives the tutor, workings review and authoring.
#   auto               first available: Claude Code, then an OpenAI-compatible API, then Codex, then companion
#   claude             the local Claude Code CLI, on your own Claude plan (no API key stored here)
#   openai-compatible  any OpenAI-style endpoint: OpenAI, OpenRouter, Ollama, LM Studio, a gateway
#   codex              the local Codex CLI
#   companion          writes a packet for you to paste into a chat you already have
#   mock               fixed offline text, used by tests
DISCERE_TUTOR_PROVIDER=auto

# Routing between a fast and a capable model, decided from the request without a model call:
# short tutoring turns and style repairs go fast; workings review, assessment, authoring, images,
# "prove/why/compare" questions, long context and any retry go to the capable model.
# auto | fast | smart
DISCERE_AI_ROUTING=auto

# Claude Code driver.
# DISCERE_CLAUDE_BIN=claude
# DISCERE_CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
# DISCERE_CLAUDE_SMART_MODEL=claude-sonnet-5-5
# DISCERE_CLAUDE_EFFORT=low

# OpenAI-compatible driver. The smart model defaults to the fast one.
# DISCERE_AI_BASE_URL=https://api.openai.com/v1
# DISCERE_AI_API_KEY=
# DISCERE_AI_FAST_MODEL=gpt-4o-mini
# DISCERE_AI_SMART_MODEL=

# Only used when DISCERE_TUTOR_PROVIDER=codex. The CLI signs in with your own subscription,
# so no API key is stored here.
DISCERE_CODEX_BIN=codex
# Pinned rather than inherited: leaving these unset makes the tutor follow whatever model the
# CLI's global config happens to name, so a change made for unrelated work would silently
# change how Discere teaches. A small model at high reasoning effort suits tutoring, where the
# questions are short and the thinking matters more than the breadth.
DISCERE_CODEX_MODEL=gpt-5.6-luna
DISCERE_CODEX_EFFORT=xhigh
# Working root handed to the CLI. It is created on demand and ignored by Git.
DISCERE_CODEX_SCRATCH=~/.local/share/discere/codex-scratch
# Wall-clock budgets. A tutor question is short; an essay assessment can take minutes.
DISCERE_TUTOR_ASK_TIMEOUT_MS=45000
DISCERE_TUTOR_ASSESS_TIMEOUT_MS=120000

# Packaged serving. When set, the API serves the built browser bundle from its own origin, which
# is what the Instrumenta launcher needs for a single hardened window. A relative path resolves
# from the repository root. Leave it unset for the normal two-process development setup.
# DISCERE_WEB_ROOT=apps/web/dist
# Applies pending migrations at boot. A launcher that has never run `pnpm db:migrate` needs it.
# DISCERE_AUTO_MIGRATE=1

# Where the MCP server in `mcp/` looks for a running Discere. It defaults to the port the
# Instrumenta launcher uses, so a development server on 4317 needs this set.
# DISCERE_URL=http://127.0.0.1:4317

# Generated illustrations. `auto` draws when the Codex CLI is installed and signed in; `off`
# disables drawing whatever the CLI reports, which is the setting for a lapsed subscription — the
# interface then hides the control instead of offering one that fails two minutes later. The tutor,
# lessons, questions, assessment, review, and every deterministic diagram are unaffected.
DISCERE_IMAGE_GENERATION=auto

# Content authoring. `pnpm author generate` spawns the same Codex CLI with a longer budget,
# because writing a lesson is slower than answering one learner question.
DISCERE_AUTHOR_TIMEOUT_MS=600000

# Query-construction practice uses Python's standard-library SQLite in isolated child processes.
# Python 3.12+ with SQLite 3.39+ is required. Defaults: python3 on Unix, python on Windows.
# No Python packages or API keys are needed. An absolute interpreter path is also supported.
# DISCERE_SQL_PYTHON=/path/to/python3

# Optional dedicated Python construction dependency directory; no bare-Python fallback.
# Set up from x86_64 Ubuntu/WSL with: pnpm python:setup
# DISCERE_PYTHON_RUNTIME_DIR=/absolute/path/to/Discere/data/python-runtime
