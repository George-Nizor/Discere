# Discere is intentionally local-only during the prototype phase.
DISCERE_HOST=127.0.0.1
DISCERE_PORT=4317
DISCERE_WEB_HOST=127.0.0.1
DISCERE_WEB_PORT=4318

# Durable local state. This file is ignored by Git.
# A relative path resolves from the repository root, not the working directory.
DISCERE_DATABASE_PATH=./data/discere.sqlite
DISCERE_LEARNER_NAME=Learner

# Tutor generation. `companion` writes a packet for you to paste into ChatGPT, `codex` spawns
# the local Codex CLI and generates in place, and `mock` returns fixed offline text.
DISCERE_TUTOR_PROVIDER=companion

# Only used when DISCERE_TUTOR_PROVIDER=codex. The CLI signs in with your own subscription,
# so no API key is stored here.
DISCERE_CODEX_BIN=codex
# Pinned rather than inherited: leaving these unset makes the tutor follow whatever model the
# CLI's global config happens to name, so a change made for unrelated work would silently
# change how Discere teaches. A small model at high reasoning effort suits tutoring, where the
# questions are short and the thinking matters more than the breadth.
DISCERE_CODEX_MODEL=gpt-5.6-luna
DISCERE_CODEX_EFFORT=xhigh
# Working root handed to the CLI. It is created on demand and ignored by Git.
DISCERE_CODEX_SCRATCH=~/.local/share/discere/codex-scratch
# Wall-clock budgets. A tutor question is short; an essay assessment can take minutes.
DISCERE_TUTOR_ASK_TIMEOUT_MS=45000
DISCERE_TUTOR_ASSESS_TIMEOUT_MS=120000

# Packaged serving. When set, the API serves the built browser bundle from its own origin, which
# is what the Instrumenta launcher needs for a single hardened window. A relative path resolves
# from the repository root. Leave it unset for the normal two-process development setup.
# DISCERE_WEB_ROOT=apps/web/dist
# Applies pending migrations at boot. A launcher that has never run `pnpm db:migrate` needs it.
# DISCERE_AUTO_MIGRATE=1

# Where the MCP server in `mcp/` looks for a running Discere. It defaults to the port the
# Instrumenta launcher uses, so a development server on 4317 needs this set.
# DISCERE_URL=http://127.0.0.1:4317

# Content authoring. `pnpm author generate` spawns the same Codex CLI with a longer budget,
# because writing a lesson is slower than answering one learner question.
DISCERE_AUTHOR_TIMEOUT_MS=600000
